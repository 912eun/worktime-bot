[Unit]
Description=Worktime Discord Bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/worktime-bot
ExecStart=/usr/bin/python3 /home/ubuntu/worktime-bot/bot.py
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
